@page
@model PresentacionWeb.Pages.Frecuencias.IndexModel
@{
    ViewData["Title"] = "Frecuencias";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0"><i class="fas fa-redo me-2"></i>Frecuencias</h2>
            <p class="text-secondary mb-0">Tipos de frecuencia para hábitos</p>
        </div>
        <a href="/Frecuencias/Crear" class="btn btn-info"><i class="fas fa-plus me-2"></i>Nueva Frecuencia</a>
    </div>

    <div id="alerta" class="alert d-none" role="alert"></div>

    <div class="table-responsive shadow-sm" style="border-radius: 10px; border: 1px solid #343a40;">
        <table class="table table-dark table-bordered table-hover align-middle mb-0">
            <thead class="table-secondary text-dark">
                <tr>
                    <th>#</th>
                    <th>Tipo Intervalo</th>
                    <th>Días Semana</th>
                    <th>Veces/Día</th>
                    <th>Personalizada</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaFrecuencias">
                <tr><td colspan="6" class="text-center text-secondary">Cargando...</td></tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;

        async function cargar() {
            const tb = document.getElementById("tablaFrecuencias");
            const res = await fetch(API_URL + "/Frecuencias/Listar", {
                headers: { "Authorization": "Bearer " + token }
            });
            const data = await res.json();

            tb.innerHTML = data.map(f => `
                <tr>
                    <td>${f.id}</td>
                    <td><span class="badge bg-info text-dark">${f.tipoIntervalo}</span></td>
                    <td>${f.diasSemana ?? '—'}</td>
                    <td>${f.vecesPorDia}</td>
                    <td>${f.esPersonalizada ? '<span class="badge bg-success">Sí</span>' : '<span class="badge bg-secondary">No</span>'}</td>
                    <td class="d-flex gap-1">
                        <a href="/Frecuencias/Editar?id=${f.id}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                        <button class="btn btn-sm btn-outline-danger" onclick="eliminar(${f.id})"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>`).join('');
        }

        async function eliminar(id) {
            if (!confirm('¿Eliminar esta frecuencia?')) return;
            const res = await fetch(API_URL + `/Frecuencias/Eliminar/${id}`, {
                method: 'DELETE',
                headers: { "Authorization": "Bearer " + token }
            });
            const al = document.getElementById('alerta');
            if (res.ok) {
                al.className='alert alert-success';
                al.textContent='Frecuencia eliminada.';
                al.classList.remove('d-none');
                cargar();
            } else {
                al.className='alert alert-danger';
                al.textContent='No se pudo eliminar.';
                al.classList.remove('d-none');
            }
        }
        cargar();
    </script>
}