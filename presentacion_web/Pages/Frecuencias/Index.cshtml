@page
@model presentacion_web.Pages.Frecuencias.IndexModel
@{
    ViewData["Title"] = "Frecuencias";
}
<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />
<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-white mb-0"><i class="fas fa-redo me-2"></i>Frecuencias</h2>
        <p class="text-secondary mb-0">Tipos de frecuencia para los hábitos</p>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-bordered table-hover align-middle">
            <thead><tr><th>#</th><th>Tipo Intervalo</th><th>Días Semana</th><th>Veces por Día</th><th>Personalizada</th></tr></thead>
            <tbody id="tablaFrecuencias"><tr><td colspan="5" class="text-center text-secondary">Cargando...</td></tr></tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        async function cargar() {
            const tbody = document.getElementById("tablaFrecuencias");
            try {
                const res = await fetch("http://localhost:5165/Frecuencias/Listar", { headers: { "Authorization": "Bearer " + token } });
                const data = await res.json();
                tbody.innerHTML = data.map(f => `<tr><td>${f.id}</td><td><span class="badge bg-info text-dark">${f.tipoIntervalo}</span></td><td>${f.diasSemana ?? '—'}</td><td>${f.vecesPorDia}</td><td>${f.esPersonalizada ? '<span class="badge bg-success">Sí</span>' : '<span class="badge bg-secondary">No</span>'}</td></tr>`).join('');
            } catch(e) { tbody.innerHTML = '<tr><td colspan="5" class="text-danger text-center">Error al cargar.</td></tr>'; }
        }
        cargar();
    </script>
}