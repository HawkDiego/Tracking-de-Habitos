@page
@model PresentacionWeb.Pages.Habitos.IndexModel
@{
    ViewData["Title"] = "Hábitos";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0">✅ Hábitos</h2>
            <p class="text-secondary mb-0">Hábitos registrados en el sistema</p>
        </div>
        <a href="/Habitos/Crear" class="btn btn-info"><i class="fas fa-plus me-2"></i>Nuevo Hábito</a>
    </div>

    <div id="alerta" class="alert d-none" role="alert"></div>

    <div class="table-responsive shadow-sm" style="border-radius: 10px; border: 1px solid #343a40;">
        <table class="table table-dark table-bordered table-hover align-middle mb-0">
            <thead class="table-secondary text-dark">
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>XP</th>
                    <th>Categoría</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="tablaHabitos">
                <tr>
                    <td colspan="7" class="text-secondary text-center">Cargando...</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;

        async function cargar() {
            const tb = document.getElementById("tablaHabitos");
            try {
                const res = await fetch(API_URL + "/Habitos/Listar", {
                    headers: { "Authorization": "Bearer " + token }
                });
                const data = await res.json();

                if (!data.length) {
                    tb.innerHTML = '<tr><td colspan="7" class="text-secondary text-center">Sin hábitos registrados.</td></tr>';
                    return;
                }

                tb.innerHTML = data.map(h => `
                    <tr>
                        <td>${h.id}</td>
                        <td class="fw-bold">${h.nombre}</td>
                        <td class="text-secondary">${h.descripcion ?? '—'}</td>
                        <td><span class="badge bg-warning text-dark">${h.xpOtorgada ?? 0} XP</span></td>
                        <td>${h.categoria ?? '—'}</td>
                        <td>${new Date(h.fechaCreacion).toLocaleDateString('es-CO')}</td>
                        <td class="d-flex gap-1">
                            <a href="/Habitos/Editar?id=${h.id}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                            <button class="btn btn-sm btn-outline-danger" onclick="eliminar(${h.id})"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>`).join('');
            } catch (e) {
                tb.innerHTML = '<tr><td colspan="7" class="text-danger text-center">Error al cargar.</td></tr>';
            }
        }

        async function eliminar(id) {
            if (!confirm('¿Eliminar este hábito?')) return;
            const res = await fetch(API_URL + `/Habitos/Eliminar/${id}`, {
                method: 'DELETE',
                headers: { "Authorization": "Bearer " + token }
            });
            const al = document.getElementById('alerta');
            if (res.ok) {
                al.className = 'alert alert-success';
                al.textContent = 'Hábito eliminado.';
                al.classList.remove('d-none');
                cargar();
            } else {
                al.className = 'alert alert-danger';
                al.textContent = 'No se pudo eliminar.';
                al.classList.remove('d-none');
            }
        }

        cargar();
    </script>
}