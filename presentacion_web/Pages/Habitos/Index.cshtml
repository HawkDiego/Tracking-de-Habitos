@page
@model presentacion_web.Pages.Habitos.IndexModel
@{
    ViewData["Title"] = "Mis Hábitos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold">
            <i class="fas fa-check-square me-2"></i>Mis Hábitos
        </h2>
        <a href="#" class="btn btn-success fw-bold shadow-sm" style="border-radius: 8px;">
            <i class="fas fa-plus-circle me-2"></i>Nuevo Hábito
        </a>
    </div>

    <hr class="border-secondary mb-4" />

    <div class="table-responsive shadow-sm" style="border-radius: 10px; border: 1px solid #343a40;">
        <table class="table table-dark table-striped table-hover mb-0 align-middle">
            <thead class="table-secondary text-dark">
                <tr>
                    <th scope="col" class="py-3 px-4">ID</th>
                    <th scope="col" class="py-3 px-4">Hábito</th>
                    <th scope="col" class="py-3 px-4">Categoría</th>
                    <th scope="col" class="py-3 px-4">Frecuencia</th>
                    <th scope="col" class="py-3 px-4" style="min-width: 150px;">Progreso</th>
                    <th scope="col" class="py-3 px-4 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="px-4 fw-bold">1</td>
                    <td class="px-4 text-light">Tomar 2 Litros de Agua</td>
                    <td class="px-4">
                        <span class="badge" style="background-color: #28a745;">
                            <i class="fas fa-dumbbell me-1"></i> Salud y Fitness
                        </span>
                    </td>
                    <td class="px-4 text-white-50">Diario</td>
                    <td class="px-4">
                        <div class="progress" style="height: 20px; background-color: #495057;">
                            <div class="progress-bar bg-info progress-bar-striped progress-bar-animated" role="progressbar" style="width: 75%;" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">75%</div>
                        </div>
                    </td>
                    <td class="px-4 text-center">
                        <button class="btn btn-sm btn-outline-success me-1" title="Marcar como cumplido hoy"><i class="fas fa-check"></i></button>
                        <button class="btn btn-sm btn-outline-info me-1" title="Editar"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="px-4 fw-bold">2</td>
                    <td class="px-4 text-light">Leer 20 páginas</td>
                    <td class="px-4">
                        <span class="badge" style="background-color: #007bff;">
                            <i class="fas fa-laptop-code me-1"></i> Desarrollo
                        </span>
                    </td>
                    <td class="px-4 text-white-50">Diario</td>
                    <td class="px-4">
                        <div class="progress" style="height: 20px; background-color: #495057;">
                            <div class="progress-bar bg-warning progress-bar-striped progress-bar-animated" role="progressbar" style="width: 40%;" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100">40%</div>
                        </div>
                    </td>
                    <td class="px-4 text-center">
                        <button class="btn btn-sm btn-outline-success me-1" title="Marcar como cumplido hoy"><i class="fas fa-check"></i></button>
                        <button class="btn btn-sm btn-outline-info me-1" title="Editar"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>