@page
@model presentacion_web.Pages.Habitos.IndexModel
@{
    ViewData["Title"] = "Hábitos";
}
<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />
<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0">✅ Hábitos</h2>
            <p class="text-secondary mb-0">Hábitos registrados en el sistema</p>
        </div>
    </div>

    <div id="alerta" class="alert d-none" role="alert"></div>

    <div class="table-responsive">
        <table class="table table-dark table-bordered table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>XP</th>
                    <th>Categoría</th>
                    <th>Fecha</th>
                </tr>
            </thead>
            <tbody id="tablaHabitos">
                <tr><td colspan="6" class="text-secondary text-center">Cargando...</td></tr>
            </tbody>
        </table>
    </div>

</div>

@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        const api = "http://localhost:5165";

        async function cargarHabitos() {
            const tbody = document.getElementById("tablaHabitos");

            if (!token) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-danger text-center">Sin token de sesión. Inicia sesión de nuevo.</td></tr>';
                return;
            }

            try {
                const res = await fetch(api + "/Habitos/Listar", {
                    headers: { "Authorization": "Bearer " + token }
                });

                if (!res.ok) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-danger text-center">Error ${res.status} al cargar hábitos.</td></tr>`;
                    return;
                }

                const habitos = await res.json();

                if (habitos.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-secondary text-center">No hay hábitos registrados.</td></tr>';
                    return;
                }

                tbody.innerHTML = habitos.map(h => `
                    <tr>
                        <td>${h.id}</td>
                        <td class="fw-bold">${h.nombre}</td>
                        <td class="text-secondary">${h.descripcion ?? '—'}</td>
                        <td><span class="badge bg-warning text-dark">${h.xpOtorgada ?? 0} XP</span></td>
                        <td>${h.categoria ?? '—'}</td>
                        <td>${new Date(h.fechaCreacion).toLocaleDateString('es-CO')}</td>
                    </tr>
                `).join('');

            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-danger text-center">No se pudo conectar con la API.</td></tr>';
            }
        }

        cargarHabitos();
    </script>
}