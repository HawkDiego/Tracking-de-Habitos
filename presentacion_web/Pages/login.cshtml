@page
@model presentacion_web.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // La pantalla de login no usa el navbar
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TrackHabit — Iniciar Sesión</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-dark d-flex align-items-center justify-content-center" style="min-height:100vh;">

    <div class="card bg-dark text-white shadow-lg p-4"
         style="width:100%;max-width:420px;border-radius:16px;border:1px solid #2d3748;">

        <div class="text-center mb-4">
            <i class="fas fa-check-double fa-3x text-info mb-3"></i>
            <h3 class="fw-bold">TrackHabit</h3>
            <p class="text-white-50 small">Ingresa tus credenciales para continuar</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-danger small" role="alert">
                <i class="fas fa-exclamation-circle me-2"></i>@Model.MensajeError
            </div>
        }

        <form method="post" autocomplete="off">
            <div class="mb-3">
                <label class="form-label text-white-50 small">Correo electrónico</label>
                <div class="input-group">
                    <span class="input-group-text bg-secondary border-0 text-white">
                        <i class="fas fa-envelope"></i>
                    </span>
                    <input type="email" asp-for="Input.Email"
                           class="form-control bg-secondary text-white border-0"
                           placeholder="correo@ejemplo.com" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label text-white-50 small">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text bg-secondary border-0 text-white">
                        <i class="fas fa-lock"></i>
                    </span>
                    <input type="password" asp-for="Input.Clave"
                           class="form-control bg-secondary text-white border-0"
                           placeholder="••••••••" />
                </div>
                <span asp-validation-for="Input.Clave" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-info w-100 fw-bold py-2">
                <i class="fas fa-sign-in-alt me-2"></i>Ingresar
            </button>
        </form>

        <p class="text-center text-white-50 small mt-4 mb-0">
            Credenciales de prueba: <code class="text-info">ana.torres@habitapp.com</code>
        </p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>