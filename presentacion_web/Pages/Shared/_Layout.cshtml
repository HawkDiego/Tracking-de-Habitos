<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrackHabit</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/presentacion_web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
</head>
<body class="bg-dark text-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary box-shadow mb-4">
            <div class="container-fluid">
                <a class="navbar-brand text-info fw-bold" asp-area="" asp-page="/Index">
                    <i class="fas fa-check-double me-2"></i>TrackHabit
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav flex-grow-1 flex-wrap">
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Index">
                                <i class="fas fa-home me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Usuarios/Index">
                                <i class="fas fa-users me-1"></i> Usuarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Categorias/Index">
                                <i class="fas fa-tags me-1"></i> Categorías
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Habitos/Index">
                                <i class="fas fa-check-square me-1"></i> Hábitos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Niveles/Index">
                                <i class="fas fa-star me-1"></i> Niveles
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Logros/Index">
                                <i class="fas fa-trophy me-1"></i> Logros
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Frecuencias/Index">
                                <i class="fas fa-redo me-1"></i> Frecuencias
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Grupos/Index">
                                <i class="fas fa-users-cog me-1"></i> Grupos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Recompensas/Index">
                                <i class="fas fa-gift me-1"></i> Recompensas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Rachas/Index">
                                <i class="fas fa-fire me-1"></i> Rachas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Desafios/Index">
                                <i class="fas fa-fist-raised me-1"></i> Desafíos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light px-2" asp-area="" asp-page="/Notas/Index">
                                <i class="fas fa-sticky-note me-1"></i> Notas
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="btn btn-outline-danger btn-sm px-3 shadow-sm" asp-area="" asp-page="/login">
                                <i class="fas fa-sign-out-alt me-1"></i> Salir
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-4">
        <div class="container py-2">
            &copy; 2026 - TrackHabit
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>