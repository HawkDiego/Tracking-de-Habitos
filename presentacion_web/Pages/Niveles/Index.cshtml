@page
@model PresentacionWeb.Pages.Niveles.IndexModel
@{
    ViewData["Title"] = "Niveles";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0">⭐ Niveles</h2>
            <p class="text-secondary mb-0">Niveles de progreso</p>
        </div>
        <a href="/Niveles/Crear" class="btn btn-info"><i class="fas fa-plus me-2"></i>Nuevo Nivel</a>
    </div>

    <div id="alerta" class="alert d-none" role="alert"></div>

    <div class="row g-3" id="listaNiveles">
        <div class="col-12 text-secondary">Cargando...</div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;
        const colores = ['secondary','info','primary','warning','danger'];

        async function cargar() {
            const c = document.getElementById("listaNiveles");
            const res = await fetch(API_URL + "/Niveles/Listar", {
                headers: { "Authorization": "Bearer " + token }
            });
            const data = await res.json();

            c.innerHTML = data.map((n, i) => `
                <div class="col-md-4 col-lg-2">
                    <div class="card bg-dark border-secondary text-white h-100">
                        <div class="card-body text-center">
                            <div class="mb-2" style="font-size:2rem">⭐</div>
                            <h5 class="fw-bold">${n.nombre}</h5>
                            <span class="badge bg-${colores[i % 5] ?? 'secondary'} mb-2">Nivel ${n.id}</span>
                            <p class="text-secondary mb-1" style="font-size:.85rem">${n.descripcion}</p>
                            <div class="mt-2 text-warning" style="font-size:.8rem">${n.limiteInferiorXp} — ${n.limiteSuperiorXp} XP</div>
                            <div class="d-flex gap-2 justify-content-center mt-3">
                                <a href="/Niveles/Editar?id=${n.id}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i></a>
                                <button class="btn btn-sm btn-outline-danger" onclick="eliminar(${n.id})"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>`).join('');
        }

        async function eliminar(id) {
            if (!confirm('¿Eliminar este nivel?')) return;
            const res = await fetch(API_URL + `/Niveles/Eliminar/${id}`, {
                method: 'DELETE',
                headers: { "Authorization": "Bearer " + token }
            });
            const al = document.getElementById('alerta');
            if (res.ok) {
                al.className='alert alert-success';
                al.textContent='Nivel eliminado.';
                al.classList.remove('d-none');
                cargar();
            } else {
                al.className='alert alert-danger';
                al.textContent='No se pudo eliminar.';
                al.classList.remove('d-none');
            }
        }
        cargar();
    </script>
}