@page
@model PresentacionWeb.Pages.Niveles.CrearModel
@{
    ViewData["Title"] = "Nuevo Nivel";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container py-4" style="max-width:600px">
    <h2 class="fw-bold text-white mb-4">⭐ Nuevo Nivel</h2>
    <div id="alerta" class="alert d-none" role="alert"></div>
    <div class="card bg-dark border-secondary text-white">
        <div class="card-body">
            <div class="mb-3"><label class="form-label">Nombre *</label><input type="text" id="nombre" class="form-control bg-secondary text-white border-0" /></div>
            <div class="mb-3"><label class="form-label">Descripción *</label><input type="text" id="descripcion" class="form-control bg-secondary text-white border-0" /></div>
            <div class="mb-3"><label class="form-label">XP Mínimo</label><input type="number" id="limiteInferiorXp" class="form-control bg-secondary text-white border-0" value="0" min="0" /></div>
            <div class="mb-4"><label class="form-label">XP Máximo</label><input type="number" id="limiteSuperiorXp" class="form-control bg-secondary text-white border-0" value="99" min="0" /></div>
            <div class="d-flex gap-2">
                <button class="btn btn-info" onclick="guardar()"><i class="fas fa-save me-2"></i>Guardar</button>
                <a href="/Niveles" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;
        async function guardar() {
            const body = { nombre: document.getElementById('nombre').value, descripcion: document.getElementById('descripcion').value, limiteInferiorXp: parseInt(document.getElementById('limiteInferiorXp').value) || 0, limiteSuperiorXp: parseInt(document.getElementById('limiteSuperiorXp').value) || 99, estado: 1 };
            if (!body.nombre || !body.descripcion) { mostrarAlerta('Nombre y descripción son obligatorios.', 'danger'); return; }
            const res = await fetch(API_URL + '/Niveles/Insertar', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token }, body: JSON.stringify(body) });
            if (res.ok || res.status === 201) window.location.href = '/Niveles';
            else mostrarAlerta('No se pudo guardar.', 'danger');
        }
        function mostrarAlerta(msg, tipo) { const a = document.getElementById('alerta'); a.className = `alert alert-${tipo}`; a.textContent = msg; a.classList.remove('d-none'); }
    </script>
}