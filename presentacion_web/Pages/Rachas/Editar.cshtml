@page
@model presentacion_web.Pages.Rachas.EditarModel
@{
    ViewData["Title"] = "Editar Racha";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container py-4" style="max-width:600px">
    <h2 class="fw-bold text-white mb-4">🔥 Editar Racha</h2>
    <div id="alerta" class="alert d-none" role="alert"></div>
    <div class="card bg-dark border-secondary text-white">
        <div class="card-body">
            <input type="hidden" id="id" />
            <div class="mb-3"><label class="form-label">ID del Hábito *</label><input type="number" id="habito" class="form-control bg-secondary text-white border-0" /></div>
            <div class="mb-3"><label class="form-label">Días Consecutivos *</label><input type="number" id="dias" class="form-control bg-secondary text-white border-0" /></div>
            <div class="mb-3"><label class="form-label">Fecha de Inicio</label><input type="date" id="fechaInicio" class="form-control bg-secondary text-white border-0" /></div>
            <div class="mb-4"><label class="form-label">Última Fecha Registrada</label><input type="date" id="ultimaFecha" class="form-control bg-secondary text-white border-0" /></div>
            <div class="d-flex gap-2">
                <button class="btn btn-warning" onclick="guardar()"><i class="fas fa-save me-2"></i>Actualizar</button>
                <a href="/Rachas" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        const API_URL = "https://localhost:7293";
        const id = new URLSearchParams(window.location.search).get('id');

        async function cargar() {
            const res = await fetch(API_URL + `/Rachas/ObtenerPorId/${id}`, { headers: { "Authorization": "Bearer " + token } });
            if (!res.ok) return;
            const d = await res.json();
            document.getElementById('id').value = d.id;
            document.getElementById('habito').value = d.habito;
            document.getElementById('dias').value = d.diasConsecutivos;
            if(d.fechaInicio) document.getElementById('fechaInicio').value = d.fechaInicio.split('T')[0];
            if(d.ultimaFecha) document.getElementById('ultimaFecha').value = d.ultimaFecha.split('T')[0];
        }

        async function guardar() {
            const valInicio = document.getElementById('fechaInicio').value;
            const valUltima = document.getElementById('ultimaFecha').value;
            const fechaInicioLimpia = valInicio ? valInicio + "T00:00:00" : new Date().toISOString().split('.')[0];
            const ultimaFechaLimpia = valUltima ? valUltima + "T00:00:00" : new Date().toISOString().split('.')[0];

            const body = {
                id: parseInt(document.getElementById('id').value),
                habito: parseInt(document.getElementById('habito').value),
                diasConsecutivos: parseInt(document.getElementById('dias').value),
                fechaInicio: fechaInicioLimpia,
                ultimaFecha: ultimaFechaLimpia,
                estado: 1
            };

            const res = await fetch(API_URL + '/Rachas/Actualizar', {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                body: JSON.stringify(body)
            });

            if (res.ok) window.location.href = '/Rachas';
            else mostrarAlerta('Error al actualizar.', 'danger');
        }
        function mostrarAlerta(msg, tipo) { const a = document.getElementById('alerta'); a.className = `alert alert-${tipo}`; a.textContent = msg; a.classList.remove('d-none'); }
        cargar();
    </script>
}