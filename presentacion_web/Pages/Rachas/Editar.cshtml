@page
@model presentacion_web.Pages.Rachas.EditarModel
@{
    ViewData["Title"] = "Editar Racha";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container py-4" style="max-width:600px">
    <h2 class="fw-bold text-white mb-4">🔥 Editar Racha</h2>
    <div id="alerta" class="alert d-none" role="alert"></div>
    <div class="card bg-dark border-secondary text-white">
        <div class="card-body">
            <input type="hidden" id="id" />

            <div class="mb-3">
                <label class="form-label">ID del Hábito *</label>
                <input type="number" id="habito" class="form-control bg-secondary text-white border-0" min="1" />
            </div>

            <div class="mb-3">
                <label class="form-label">Conteo Actual (días consecutivos)</label>
                <input type="number" id="conteoActual" class="form-control bg-secondary text-white border-0" min="0" />
            </div>

            <div class="mb-3">
                <label class="form-label">Máxima Histórica</label>
                <input type="number" id="maximaHistorica" class="form-control bg-secondary text-white border-0" min="0" />
            </div>

            <div class="mb-3">
                <label class="form-label">Fecha Último Incremento</label>
                <input type="date" id="fechaUltimoIncremento" class="form-control bg-secondary text-white border-0" />
            </div>

            <div class="mb-4">
                <label class="form-label">Multiplicador XP</label>
                <input type="number" id="multiplicadorXp" class="form-control bg-secondary text-white border-0"
                       min="1.00" max="5.00" step="0.05" />
                <div class="form-text text-secondary">Por ejemplo: 1.00, 1.10, 1.30</div>
            </div>

            <div class="d-flex gap-2">
                <button class="btn btn-warning" onclick="guardar()">
                    <i class="fas fa-save me-2"></i>Actualizar
                </button>
                <a href="/Rachas" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        const API_URL = "https://localhost:7293";
        const id = new URLSearchParams(window.location.search).get('id');

        async function cargar() {
            const res = await fetch(API_URL + `/Rachas/ObtenerPorId/${id}`, {
                headers: { "Authorization": "Bearer " + token }
            });

            if (!res.ok) {
                mostrarAlerta('No se encontró la racha.', 'danger');
                return;
            }

            const d = await res.json();
            document.getElementById('id').value = d.id;
            document.getElementById('habito').value = d.habito;
            document.getElementById('conteoActual').value = d.conteoActual ?? 0;
            document.getElementById('maximaHistorica').value = d.maximaHistorica ?? 0;
            document.getElementById('multiplicadorXp').value = d.multiplicadorXp ?? 1.00;

            if (d.fechaUltimoIncremento) {
                document.getElementById('fechaUltimoIncremento').value =
                    d.fechaUltimoIncremento.split('T')[0];
            }
        }

        async function guardar() {
            const fechaVal = document.getElementById('fechaUltimoIncremento').value;

            const body = {
                id: parseInt(document.getElementById('id').value),
                habito: parseInt(document.getElementById('habito').value),
                conteoActual: parseInt(document.getElementById('conteoActual').value) || 0,
                maximaHistorica: parseInt(document.getElementById('maximaHistorica').value) || 0,
                fechaUltimoIncremento: fechaVal ? fechaVal + "T00:00:00" : null,
                multiplicadorXp: parseFloat(document.getElementById('multiplicadorXp').value) || 1.00,
                estado: 1
            };

            const res = await fetch(API_URL + '/Rachas/Actualizar', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(body)
            });

            if (res.ok) {
                window.location.href = '/Rachas';
            } else {
                mostrarAlerta('Error al actualizar.', 'danger');
            }
        }

        function mostrarAlerta(msg, tipo) {
            const a = document.getElementById('alerta');
            a.className = `alert alert-${tipo}`;
            a.textContent = msg;
            a.classList.remove('d-none');
        }

        cargar();
    </script>
}
