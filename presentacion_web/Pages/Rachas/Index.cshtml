@page
@model presentacion_web.Pages.Rachas.IndexModel
@{
    ViewData["Title"] = "Rachas";
}
<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />
<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-white mb-0"><i class="fas fa-fire me-2"></i>Rachas</h2>
        <p class="text-secondary mb-0">Rachas activas de hábitos</p>
    </div>
    <div class="table-responsive">
        <table class="table table-dark table-bordered table-hover align-middle">
            <thead><tr><th>#</th><th>Hábito</th><th>Racha actual</th><th>Máxima histórica</th><th>Multiplicador XP</th><th>Último incremento</th></tr></thead>
            <tbody id="tablaRachas"><tr><td colspan="6" class="text-center text-secondary">Cargando...</td></tr></tbody>
        </table>
    </div>
</div>
@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        async function cargar() {
            const tbody = document.getElementById("tablaRachas");
            try {
                const res = await fetch("http://localhost:5165/Rachas/Listar", { headers: { "Authorization": "Bearer " + token } });
                const data = await res.json();
                tbody.innerHTML = data.map(r => `<tr>
                    <td>${r.id}</td>
                    <td>Hábito #${r.habito}</td>
                    <td><span class="badge bg-danger">${r.conteoActual ?? 0} días</span></td>
                    <td><span class="badge bg-warning text-dark">${r.maximaHistorica ?? 0} días</span></td>
                    <td><span class="badge bg-success">x${r.multiplicadorXp ?? 1}</span></td>
                    <td>${r.fechaUltimoIncremento ? new Date(r.fechaUltimoIncremento).toLocaleDateString('es-CO') : '—'}</td>
                </tr>`).join('');
            } catch(e) { tbody.innerHTML = '<tr><td colspan="6" class="text-danger text-center">Error al cargar.</td></tr>'; }
        }
        cargar();
    </script>
}