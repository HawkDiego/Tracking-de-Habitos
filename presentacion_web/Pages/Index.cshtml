@page
@model presentacion_web.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var usuario = HttpContext.Session.GetString("UsuarioNombre") ?? "Usuario";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container-fluid py-4">

    <div class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <h2 class="fw-bold text-white">Bienvenido, @usuario 👋</h2>
            <p class="text-secondary">Aquí está tu resumen de hábitos</p>
        </div>
        <button onclick="exportarExcel()" class="btn btn-success">
            <i class="fas fa-file-excel me-2"></i>Exportar Reporte Excel
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-white">
                <div class="card-body">
                    <p class="text-secondary mb-1">Hábitos activos</p>
                    <h3 class="fw-bold" id="totalHabitos">⏳</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-white">
                <div class="card-body">
                    <p class="text-secondary mb-1">Categorías</p>
                    <h3 class="fw-bold" id="totalCategorias">⏳</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-white">
                <div class="card-body">
                    <p class="text-secondary mb-1">Usuarios</p>
                    <h3 class="fw-bold" id="totalUsuarios">⏳</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-dark border-secondary text-white">
                <div class="card-body">
                    <p class="text-secondary mb-1">Estado API</p>
                    <h3 class="fw-bold text-success" id="estadoApi">⏳</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <a href="/Categorias" class="text-decoration-none">
                <div class="card bg-dark border-secondary text-white h-100">
                    <div class="card-body">
                        <h5>📂 Categorías</h5>
                        <p class="text-secondary">Ver y gestionar categorías de hábitos</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Habitos" class="text-decoration-none">
                <div class="card bg-dark border-secondary text-white h-100">
                    <div class="card-body">
                        <h5>✅ Hábitos</h5>
                        <p class="text-secondary">Revisa tus hábitos y su progreso</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Usuarios" class="text-decoration-none">
                <div class="card bg-dark border-secondary text-white h-100">
                    <div class="card-body">
                        <h5>👤 Usuarios</h5>
                        <p class="text-secondary">Administrar usuarios registrados</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        const api = "http://localhost:5165";

        async function cargar(url, elementId) {
            try {
                const res = await fetch(url, {
                    headers: { "Authorization": "Bearer " + token }
                });
                if (res.ok) {
                    const data = await res.json();
                    document.getElementById(elementId).textContent = data.length;
                } else {
                    document.getElementById(elementId).textContent = "—";
                }
            } catch (e) {
                document.getElementById(elementId).textContent = "—";
            }
        }

        cargar(api + "/Habitos/Listar",    "totalHabitos");
        cargar(api + "/Categorias/Listar", "totalCategorias");
        cargar(api + "/Usuarios/Listar",   "totalUsuarios");
        document.getElementById("estadoApi").textContent = "✓ Online";
        document.getElementById("estadoApi").className = "fw-bold text-success";

        function exportarExcel() {
            Promise.all([
                fetch(api + "/Usuarios/Listar",   { headers: { "Authorization": "Bearer " + token } }).then(r => r.json()),
                fetch(api + "/Habitos/Listar",    { headers: { "Authorization": "Bearer " + token } }).then(r => r.json()),
                fetch(api + "/Categorias/Listar", { headers: { "Authorization": "Bearer " + token } }).then(r => r.json()),
                fetch(api + "/Niveles/Listar",    { headers: { "Authorization": "Bearer " + token } }).then(r => r.json())
            ]).then(([usuarios, habitos, categorias, niveles]) => {
                const wb = XLSX.utils.book_new();

                XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(usuarios.map(u => ({
                    ID: u.id, Nombre: u.nombre, Email: u.email,
                    'XP Total': u.xpTotal, Nivel: u.nivel
                }))), "Usuarios");

                XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(habitos.map(h => ({
                    ID: h.id, Nombre: h.nombre, Descripcion: h.descripcion,
                    'XP': h.xpOtorgada, Categoria: h.categoria
                }))), "Hábitos");

                XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(categorias.map(c => ({
                    ID: c.id, Nombre: c.nombre, Descripcion: c.descripcion, Color: c.color
                }))), "Categorías");

                XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(niveles.map(n => ({
                    ID: n.id, Nombre: n.nombre, 'XP Mínimo': n.limiteInferiorXp,
                    'XP Máximo': n.limiteSuperiorXp, Descripcion: n.descripcion
                }))), "Niveles");

                XLSX.writeFile(wb, "Reporte_TrackHabit.xlsx");
            }).catch(e => alert("Error al generar el reporte: " + e));
        }
    </script>
}