@page
@model PresentacionWeb.Pages.Recompensas.EditarModel
@{
    ViewData["Title"] = "Editar Recompensa";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container py-4" style="max-width:600px">
    <h2 class="fw-bold text-white mb-4"><i class="fas fa-gift me-2"></i>Editar Recompensa</h2>
    <div id="alerta" class="alert d-none" role="alert"></div>
    <div class="card bg-dark border-secondary text-white">
        <div class="card-body">
            <input type="hidden" id="id" />
            <div class="mb-3"><label class="form-label">Nombre *</label><input type="text" id="nombre" class="form-control bg-secondary text-white border-0" /></div>
            <div class="mb-3"><label class="form-label">Descripción</label><textarea id="descripcion" class="form-control bg-secondary text-white border-0" rows="3"></textarea></div>
            <div class="mb-3"><label class="form-label">Nivel Requerido (ID)</label><input type="number" id="nivelRequerido" class="form-control bg-secondary text-white border-0" min="1" /></div>
            <div class="mb-4 form-check">
                <input type="checkbox" class="form-check-input" id="esEstetica" />
                <label class="form-check-label" for="esEstetica">Es Estética</label>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-warning" onclick="guardar()"><i class="fas fa-save me-2"></i>Actualizar</button>
                <a href="/Recompensas" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;
        const id = new URLSearchParams(window.location.search).get('id');
        async function cargar() {
            const res = await fetch(API_URL + `/Recompensas/ObtenerPorId/${id}`, { headers: { "Authorization": "Bearer " + token } });
            const d = await res.json();
            document.getElementById('id').value = d.id;
            document.getElementById('nombre').value = d.nombre ?? '';
            document.getElementById('descripcion').value = d.descripcion ?? '';
            document.getElementById('nivelRequerido').value = d.nivelRequerido ?? '';
            document.getElementById('esEstetica').checked = d.esEstetica;
        }
        async function guardar() {
            const niv = document.getElementById('nivelRequerido').value;
            const body = { id: parseInt(document.getElementById('id').value), nombre: document.getElementById('nombre').value, descripcion: document.getElementById('descripcion').value, nivelRequerido: niv ? parseInt(niv) : null, esEstetica: document.getElementById('esEstetica').checked, estado: 1 };
            const res = await fetch(API_URL + '/Recompensas/Actualizar', { method: 'PUT', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token }, body: JSON.stringify(body) });
            if (res.ok) window.location.href = '/Recompensas';
            else mostrarAlerta('No se pudo actualizar.', 'danger');
        }
        function mostrarAlerta(msg, tipo) { const a = document.getElementById('alerta'); a.className = `alert alert-${tipo}`; a.textContent = msg; a.classList.remove('d-none'); }
        cargar();
    </script>
}