@page
@model presentacion_web.Pages.Recompensas.IndexModel
@{
    ViewData["Title"] = "Recompensas";
}
<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />
<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-white mb-0"><i class="fas fa-gift me-2"></i>Recompensas</h2>
        <p class="text-secondary mb-0">Recompensas desbloqueables por nivel</p>
    </div>
    <div class="row g-3" id="listaRecompensas"><div class="text-secondary">Cargando...</div></div>
</div>
@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        async function cargar() {
            const c = document.getElementById("listaRecompensas");
            try {
                const res = await fetch("http://localhost:5165/Recompensas/Listar", { headers: { "Authorization": "Bearer " + token } });
                const data = await res.json();
                c.innerHTML = data.map(r => `
                    <div class="col-md-4">
                        <div class="card bg-dark border-secondary text-white h-100">
                            <div class="card-body">
                                <div style="font-size:2rem" class="mb-2">🎁</div>
                                <h6 class="fw-bold">${r.nombre}</h6>
                                <p class="text-secondary mb-2" style="font-size:0.85rem">${r.descripcion ?? ''}</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-primary">Nivel ${r.nivelRequerido ?? '—'}</span>
                                    <span class="badge ${r.esEstetica ? 'bg-pink text-white' : 'bg-secondary'}">${r.esEstetica ? '✨ Estética' : '⚙️ Funcional'}</span>
                                </div>
                            </div>
                        </div>
                    </div>`).join('');
            } catch(e) { c.innerHTML = '<div class="text-danger">Error al cargar.</div>'; }
        }
        cargar();
    </script>
}