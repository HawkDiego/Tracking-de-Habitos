@page
@model PresentacionWeb.Pages.Recompensas.IndexModel
@{
    ViewData["Title"] = "Recompensas";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0"><i class="fas fa-gift me-2"></i>Recompensas</h2>
            <p class="text-secondary mb-0">Recompensas desbloqueables</p>
        </div>
        <a href="/Recompensas/Crear" class="btn btn-info"><i class="fas fa-plus me-2"></i>Nueva Recompensa</a>
    </div>

    <div id="alerta" class="alert d-none" role="alert"></div>

    <div class="row g-3" id="listaRecompensas">
        <div class="col-12 text-secondary">Cargando...</div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;

        async function cargar() {
            const c = document.getElementById("listaRecompensas");
            const res = await fetch(API_URL + "/Recompensas/Listar", {
                headers: { "Authorization": "Bearer " + token }
            });
            const data = await res.json();

            c.innerHTML = data.map(r => `
                <div class="col-md-4">
                    <div class="card bg-dark border-secondary text-white h-100">
                        <div class="card-body">
                            <div style="font-size:2rem" class="mb-2">🎁</div>
                            <h6 class="fw-bold">${r.nombre}</h6>
                            <p class="text-secondary mb-2" style="font-size:.85rem">${r.descripcion ?? ''}</p>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-primary">Nivel ${r.nivelRequerido ?? '—'}</span>
                                <span class="badge ${r.esEstetica ? 'bg-info text-dark' : 'bg-secondary'}">${r.esEstetica ? '✨ Estética' : '⚙️ Funcional'}</span>
                            </div>
                            <div class="d-flex gap-2">
                                <a href="/Recompensas/Editar?id=${r.id}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i> Editar</a>
                                <button class="btn btn-sm btn-outline-danger" onclick="eliminar(${r.id})"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>`).join('');
        }

        async function eliminar(id) {
            if (!confirm('¿Eliminar esta recompensa?')) return;
            const res = await fetch(API_URL + `/Recompensas/Eliminar/${id}`, {
                method: 'DELETE',
                headers: { "Authorization": "Bearer " + token }
            });
            const al = document.getElementById('alerta');
            if (res.ok) {
                al.className='alert alert-success';
                al.textContent='Recompensa eliminada.';
                al.classList.remove('d-none');
                cargar();
            } else {
                al.className='alert alert-danger';
                al.textContent='No se pudo eliminar.';
                al.classList.remove('d-none');
            }
        }
        cargar();
    </script>
}