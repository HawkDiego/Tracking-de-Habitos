@page
@model PresentacionWeb.Pages.Usuarios.CrearModel
@{
    ViewData["Title"] = "Nuevo Usuario";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container py-4" style="max-width:600px">
    <h2 class="fw-bold text-white mb-4">👤 Nuevo Usuario</h2>
    <div id="alerta" class="alert d-none" role="alert"></div>
    <div class="card bg-dark border-secondary text-white">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Nombre *</label>
                <input type="text" id="nombre" class="form-control bg-secondary text-white border-0" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email *</label>
                <input type="email" id="email" class="form-control bg-secondary text-white border-0" />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña *</label>
                <input type="password" id="clave" class="form-control bg-secondary text-white border-0" />
            </div>
            <div class="mb-3">
                <label class="form-label">Nivel</label>
                <select id="nivel" class="form-select bg-secondary text-white border-0">
                    <option value="1">1 - Inicial</option>
                    <option value="2">2 - Constante</option>
                    <option value="3">3 - Comprometido</option>
                    <option value="4">4 - Avanzado</option>
                    <option value="5">5 - Elite</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="form-label">XP Inicial</label>
                <input type="number" id="xpTotal" class="form-control bg-secondary text-white border-0" value="0" min="0" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-info" onclick="guardar()"><i class="fas fa-save me-2"></i>Guardar</button>
                <a href="/Usuarios" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;

        async function guardar() {
            const body = {
                nombre: document.getElementById('nombre').value,
                email: document.getElementById('email').value,
                clave: document.getElementById('clave').value,
                nivel: parseInt(document.getElementById('nivel').value),
                xpTotal: parseInt(document.getElementById('xpTotal').value) || 0,
                fechaRegistro: new Date().toISOString(),
                estado: 1
            };

            if (!body.nombre || !body.email || !body.clave) {
                mostrarAlerta('Nombre, email y contraseña son obligatorios.', 'danger');
                return;
            }

            const res = await fetch(API_URL + '/Usuarios/Insertar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(body)
            });

            if (res.ok || res.status === 201) {
                window.location.href = '/Usuarios';
            } else {
                const err = await res.json().catch(() => ({}));
                mostrarAlerta(err.detail || 'No se pudo guardar.', 'danger');
            }
        }

        function mostrarAlerta(msg, tipo) {
            const a = document.getElementById('alerta');
            a.className = `alert alert-${tipo}`;
            a.textContent = msg;
            a.classList.remove('d-none');
        }
    </script>
}