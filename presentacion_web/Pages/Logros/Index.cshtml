@page
@model presentacion_web.Pages.Logros.IndexModel
@{
    ViewData["Title"] = "Logros";
}
<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />
<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-white mb-0"><i class="fas fa-trophy me-2"></i>Logros</h2>
        <p class="text-secondary mb-0">Logros disponibles en el sistema</p>
    </div>
    <div class="row g-3" id="listaLogros"><div class="text-secondary">Cargando...</div></div>
</div>
@section Scripts {
    <script>
        const token = document.getElementById('jwtToken').value;
        async function cargar() {
            const c = document.getElementById("listaLogros");
            try {
                const res = await fetch("http://localhost:5165/Logros/Listar", { headers: { "Authorization": "Bearer " + token } });
                const data = await res.json();
                c.innerHTML = data.map(l => `
                    <div class="col-md-4 col-lg-3">
                        <div class="card bg-dark border-secondary text-white h-100">
                            <div class="card-body text-center">
                                <div style="font-size:2.5rem" class="mb-2">🏆</div>
                                <h6 class="fw-bold">${l.titulo}</h6>
                                <p class="text-secondary mb-2" style="font-size:0.85rem">${l.descripcionRequisito ?? ''}</p>
                                <span class="badge bg-warning text-dark">${l.xpOtorgada} XP</span>
                            </div>
                        </div>
                    </div>`).join('');
            } catch(e) { c.innerHTML = '<div class="text-danger">Error al cargar.</div>'; }
        }
        cargar();
    </script>
}