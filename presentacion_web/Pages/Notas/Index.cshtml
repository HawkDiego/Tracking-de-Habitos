@page
@model PresentacionWeb.Pages.Notas.IndexModel
@{
    ViewData["Title"] = "Notas";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0"><i class="fas fa-sticky-note me-2"></i>Notas</h2>
            <p class="text-secondary mb-0">Notas de progreso</p>
        </div>
        <a href="/Notas/Crear" class="btn btn-info"><i class="fas fa-plus me-2"></i>Nueva Nota</a>
    </div>

    <div id="alerta" class="alert d-none" role="alert"></div>

    <div class="row g-3" id="listaNotas">
        <div class="col-12 text-secondary">Cargando...</div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;

        async function cargar() {
            const c = document.getElementById("listaNotas");
            const res = await fetch(API_URL + "/Notas/Listar", {
                headers: { "Authorization": "Bearer " + token }
            });
            const data = await res.json();

            c.innerHTML = data.map(n => `
                <div class="col-md-4">
                    <div class="card bg-dark border-secondary text-white h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span style="font-size:1.5rem">${n.estadoDeAnimoEmoji || '📝'}</span>
                                <small class="text-secondary">${new Date(n.fechaCreacion).toLocaleDateString('es-CO')}</small>
                            </div>
                            <p class="mb-2">${n.texto ?? '—'}</p>
                            <span class="badge ${n.esPrivada ? 'bg-secondary' : 'bg-info text-dark'}">${n.esPrivada ? '🔒 Privada' : '🌐 Pública'}</span>
                            <div class="d-flex gap-2 mt-3">
                                <a href="/Notas/Editar?id=${n.id}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i> Editar</a>
                                <button class="btn btn-sm btn-outline-danger" onclick="eliminar(${n.id})"><i class="fas fa-trash"></i></button>
                            </div>
                        </div>
                    </div>
                </div>`).join('');
        }

        async function eliminar(id) {
            if (!confirm('¿Eliminar esta nota?')) return;
            const res = await fetch(API_URL + `/Notas/Eliminar/${id}`, {
                method: 'DELETE',
                headers: { "Authorization": "Bearer " + token }
            });
            const al = document.getElementById('alerta');
            if (res.ok) {
                al.className='alert alert-success';
                al.textContent='Nota eliminada.';
                al.classList.remove('d-none');
                cargar();
            } else {
                al.className='alert alert-danger';
                al.textContent='No se pudo eliminar.';
                al.classList.remove('d-none');
            }
        }
        cargar();
    </script>
}