@page
@model PresentacionWeb.Pages.Categorias.CrearModel
@{
    ViewData["Title"] = "Nueva Categoría";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container py-4" style="max-width:600px">
    <h2 class="fw-bold text-white mb-4">📂 Nueva Categoría</h2>
    <div id="alerta" class="alert d-none" role="alert"></div>
    <div class="card bg-dark border-secondary text-white">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">Nombre *</label>
                <input type="text" id="nombre" class="form-control bg-secondary text-white border-0" placeholder="Ej: Salud" />
            </div>
            <div class="mb-3">
                <label class="form-label">Descripción</label>
                <textarea id="descripcion" class="form-control bg-secondary text-white border-0" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Color</label>
                <input type="color" id="color" class="form-control form-control-color bg-secondary border-0" value="#22C55E" />
            </div>
            <div class="mb-4">
                <label class="form-label">Ícono (emoji)</label>
                <input type="text" id="icono" class="form-control bg-secondary text-white border-0" placeholder="💪" maxlength="10" />
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-info" onclick="guardar()"><i class="fas fa-save me-2"></i>Guardar</button>
                <a href="/Categorias" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293";
        const token = document.getElementById('jwtToken').value;

        async function guardar() {
            const body = {
                nombre: document.getElementById('nombre').value,
                descripcion: document.getElementById('descripcion').value,
                color: document.getElementById('color').value,
                icono: document.getElementById('icono').value,
                estado: 1
            };

            if (!body.nombre) {
                mostrarAlerta('El nombre es obligatorio.', 'danger');
                return;
            }

            const res = await fetch(API_URL + '/Categorias/Insertar', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + token
                },
                body: JSON.stringify(body)
            });

            if (res.ok || res.status === 201) {
                window.location.href = '/Categorias';
            } else {
                mostrarAlerta('No se pudo guardar.', 'danger');
            }
        }

        function mostrarAlerta(msg, tipo) {
            const a = document.getElementById('alerta');
            a.className = `alert alert-${tipo}`;
            a.textContent = msg;
            a.classList.remove('d-none');
        }
    </script>
}