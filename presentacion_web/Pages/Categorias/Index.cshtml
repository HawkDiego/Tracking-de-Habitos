@page
@model presentacion_web.Pages.Categorias.IndexModel
@{
    ViewData["Title"] = "Categorías de Hábitos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-info fw-bold">
            <i class="fas fa-tags me-2"></i>Categorías
        </h2>
        <a href="#" class="btn btn-success fw-bold shadow-sm" style="border-radius: 8px;">
            <i class="fas fa-plus-circle me-2"></i>Nueva Categoría
        </a>
    </div>

    <hr class="border-secondary mb-4" />

    <div class="table-responsive shadow-sm" style="border-radius: 10px; border: 1px solid #343a40;">
        <table class="table table-dark table-striped table-hover mb-0 align-middle">
            <thead class="table-secondary text-dark">
                <tr>
                    <th scope="col" class="py-3 px-4">ID</th>
                    <th scope="col" class="py-3 px-4">Nombre</th>
                    <th scope="col" class="py-3 px-4">Descripción</th>
                    <th scope="col" class="py-3 px-4 text-center">Distintivo visual</th>
                    <th scope="col" class="py-3 px-4 text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="px-4 fw-bold">1</td>
                    <td class="px-4">Salud y Fitness</td>
                    <td class="px-4 text-white-50">Hábitos relacionados con el ejercicio y la dieta</td>
                    <td class="px-4 text-center">
                        <span class="badge p-2" style="background-color: #28a745; font-size: 14px;">
                            <i class="fas fa-dumbbell"></i>
                        </span>
                    </td>
                    <td class="px-4 text-center">
                        <button class="btn btn-sm btn-outline-info me-1" title="Editar"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
                <tr>
                    <td class="px-4 fw-bold">2</td>
                    <td class="px-4">Desarrollo Profesional</td>
                    <td class="px-4 text-white-50">Estudios, programación y lectura</td>
                    <td class="px-4 text-center">
                        <span class="badge p-2" style="background-color: #007bff; font-size: 14px;">
                            <i class="fas fa-laptop-code"></i>
                        </span>
                    </td>
                    <td class="px-4 text-center">
                        <button class="btn btn-sm btn-outline-info me-1" title="Editar"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-sm btn-outline-danger" title="Eliminar"><i class="fas fa-trash-alt"></i></button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>