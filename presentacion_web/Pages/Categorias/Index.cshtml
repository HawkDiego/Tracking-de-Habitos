@page
@model PresentacionWeb.Pages.Categorias.IndexModel
@{
    ViewData["Title"] = "Categorías";
}

<input type="hidden" id="jwtToken" value="@HttpContext.Session.GetString("JWToken")" />

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-0">📂 Categorías</h2>
            <p class="text-secondary mb-0">Categorías de hábitos registradas</p>
        </div>
        <a href="/Categorias/Crear" class="btn btn-info"><i class="fas fa-plus me-2"></i>Nueva Categoría</a>
    </div>

    <div id="alerta" class="alert d-none" role="alert"></div>

    <div class="row g-3" id="listaCategorias">
        <div class="col-12 text-secondary">Cargando...</div>
    </div>
</div>

@section Scripts {
    <script>
        const API_URL = "https://localhost:7293"; // Apuntando a su backend real
        const token = document.getElementById('jwtToken').value;

        async function cargar() {
            const c = document.getElementById("listaCategorias");
            try {
                const res = await fetch(API_URL + "/Categorias/Listar", {
                    headers: { "Authorization": "Bearer " + token }
                });
                const data = await res.json();

                if (!data.length) {
                    c.innerHTML = '<div class="text-secondary">Sin categorías.</div>';
                    return;
                }

                c.innerHTML = data.map(cat => `
                    <div class="col-md-4 col-lg-3">
                        <div class="card bg-dark border-secondary text-white h-100">
                            <div class="card-body">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span style="font-size:1.8rem">${cat.icono ?? '📁'}</span>
                                    <h5 class="mb-0 fw-bold">${cat.nombre}</h5>
                                </div>
                                <p class="text-secondary mb-2" style="font-size:.9rem">${cat.descripcion ?? ''}</p>
                                <span class="badge rounded-pill px-3 py-1" style="background-color:${cat.color ?? '#555'};color:#fff">${cat.color ?? 'Sin color'}</span>
                                <div class="mt-3 d-flex gap-2">
                                    <a href="/Categorias/Editar?id=${cat.id}" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i> Editar</a>
                                    <button class="btn btn-sm btn-outline-danger" onclick="eliminar(${cat.id})"><i class="fas fa-trash"></i> Eliminar</button>
                                </div>
                            </div>
                        </div>
                    </div>`).join('');
            } catch(e) {
                c.innerHTML = '<div class="text-danger">Error al cargar.</div>';
            }
        }

        async function eliminar(id) {
            if (!confirm('¿Eliminar esta categoría?')) return;
            const res = await fetch(API_URL + `/Categorias/Eliminar/${id}`, {
                method: 'DELETE',
                headers: { "Authorization": "Bearer " + token }
            });
            const al = document.getElementById('alerta');
            if (res.ok) {
                al.className = 'alert alert-success';
                al.textContent = 'Categoría eliminada.';
                al.classList.remove('d-none');
                cargar();
            } else {
                al.className = 'alert alert-danger';
                al.textContent = 'No se pudo eliminar.';
                al.classList.remove('d-none');
            }
        }

        cargar();
    </script>
}